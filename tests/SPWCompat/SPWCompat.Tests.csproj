<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <BarotraumaDir Condition="'$(BarotraumaDir)' == ''">$(MSBuildProjectDirectory)/../../../..</BarotraumaDir>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../CSharp/SpwDistancePitch.cs" />
    <Compile Include="Program.cs" />
    <Reference Include="Barotrauma"><HintPath>$(BarotraumaDir)/Publicized/Barotrauma.dll</HintPath></Reference>
    <Reference Include="BarotraumaCore"><HintPath>$(BarotraumaDir)/Publicized/BarotraumaCore.dll</HintPath></Reference>
    <Reference Include="0Harmony"><HintPath>$(BarotraumaDir)/0Harmony.dll</HintPath></Reference>
    <Reference Include="MonoGame.Framework.Windows.NetStandard"><HintPath>$(BarotraumaDir)/MonoGame.Framework.Windows.NetStandard.dll</HintPath></Reference>
    <Reference Include="XNATypes"><HintPath>$(BarotraumaDir)/XNATypes.dll</HintPath></Reference>
  </ItemGroup>
</Project>
